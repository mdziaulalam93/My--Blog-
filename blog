.hero-content h1 {
  font-family: var(--font-serif);
  font-size: clamp(2.4rem, 6vw, 5rem);
  font-weight: 700;
  line-height: 1.12;
  color: var(--clr-white);
  margin-bottom: 1.25rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.4s forwards;
}
.hero-content h1 em {
  font-style: italic;
  color: var(--clr-accent);
}

.hero-sub {
  font-size: clamp(0.95rem, 2vw, 1.15rem);
  color: rgba(224,221,216,0.75);
  max-width: 520px;
  margin-bottom: 2rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.6s forwards;
}

.hero-content .btn {
  opacity: 0;
  animation: fadeUp 0.8s 0.8s forwards;
}

/* Scroll hint */
.hero-scroll-hint {
  position: absolute;
  bottom: 2.5rem;
  left: 50%;
  translate: -50% 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--clr-muted);
  z-index: 1;
  animation: fadeIn 1s 1.5s both;
}
.scroll-line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, var(--clr-accent), transparent);
  animation: scrollPulse 2s infinite;
}

/* =====================================================
   FEATURED POSTS
   ===================================================== */
.featured {
  padding-block: clamp(4rem, 10vw, 8rem);
}

.section-header {
  text-align: center;
  margin-bottom: clamp(2.5rem, 6vw, 4rem);
}
.section-header h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  color: var(--clr-white);
  margin-bottom: 0.4em;
}
.section-header p {
  color: var(--clr-muted);
  font-size: 1rem;
}

/* ---- Hero post card ---- */
.post-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  margin-bottom: clamp(2rem, 5vw, 3.5rem);
  border-radius: var(--radius-lg);
  overflow: hidden;
  min-height: 420px;
}
.post-hero .card-img-wrap {
  border-radius: 0;
}
.post-hero .card-img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.post-hero:hover .card-img-wrap img,
.post-hero:focus .card-img-wrap img {
  transform: scale(1.04);
}
.post-hero .card-body {
  padding: clamp(1.5rem, 4vw, 3rem);
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--clr-surface-2);
}
.post-hero .card-body h3 {
  font-size: clamp(1.2rem, 2.5vw, 1.75rem);
  font-family: var(--font-serif);
  margin-bottom: 0.75em;
  line-height: 1.3;
}

@media (max-width: 768px) {
  .post-hero {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .post-hero .card-img-wrap { height: 260px; }
}

/* ---- Card ---- */
.card {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  cursor: pointer;
  outline-offset: 3px;
}
.card:hover, .card:focus-visible {
  transform: translateY(-4px);
  box-shadow: 0 12px 48px rgba(0,0,0,0.7);
  border-color: rgba(201,169,110,0.35);
  outline: none;
}

.card-img-wrap {
  overflow: hidden;
  aspect-ratio: 16/9;
  border-radius: 0;
}
.card-img-wrap img {
  width: 100%; height: 100%;
  transition: transform 0.5s ease;
}
.card:hover .card-img-wrap img, .card:focus-visible .card-img-wrap img {
  transform: scale(1.06);
}

.card-body {
  padding: clamp(1rem, 3vw, 1.5rem);
}
.card-body h3 {
  font-family: var(--font-serif);
  font-size: clamp(1rem, 2vw, 1.2rem);
  line-height: 1.35;
  margin-bottom: 0.5em;
  color: var(--clr-white);
}
.card-body h3 a {
  transition: color var(--transition);
}
.card-body h3 a:hover { color: var(--clr-accent); }
.card-body p {
  font-size: 0.9rem;
  color: var(--clr-muted);
  margin-bottom: 1em;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 0.5em;
  font-size: 0.78rem;
  color: var(--clr-muted);
}

/* Posts grid */
.posts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  gap: clamp(1rem, 3vw, 1.75rem);
}

/* =====================================================
   QUOTE BREAK
   ===================================================== */
.quote-break {
  padding-block: clamp(4rem, 10vw, 7rem);
  background: linear-gradient(135deg, #13100a 0%, #0d0d0f 60%, #0f0c09 100%);
  text-align: center;
  border-top: 1px solid var(--clr-border);
  border-bottom: 1px solid var(--clr-border);
}
.quote-break blockquote {
  max-width: 680px;
  margin-inline: auto;
}
.quote-break blockquote p {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(1.4rem, 3.5vw, 2.2rem);
  color: var(--clr-white);
  line-height: 1.45;
  margin-bottom: 1rem;
}
.quote-break blockquote p::before { content: '\201C'; color: var(--clr-accent); margin-right: 0.1em; }
.quote-break blockquote p::after  { content: '\201D'; color: var(--clr-accent); margin-left: 0.1em; }
.quote-break blockquote footer {
  font-size: 0.875rem;
  letter-spacing: 0.08em;
  color: var(--clr-muted);
}

/* =====================================================
   MORE STORIES SECTION
   ===================================================== */
.more-stories {
  padding-block: clamp(4rem, 10vw, 8rem);
  border-top: 1px solid var(--clr-border);
  background: var(--clr-surface);
}

/* =====================================================
   RANDOM STORY SECTION
   ===================================================== */
.random-story-section {
  padding-block: clamp(4rem, 10vw, 7rem);
  background: linear-gradient(160deg, #0f0c09 0%, #0d0d0f 50%, #0c0f0d 100%);
  border-top: 1px solid var(--clr-border);
  border-bottom: 1px solid var(--clr-border);
  text-align: center;
}
.random-inner {
  max-width: 600px;
}
.random-deco {
  font-size: 2rem;
  color: var(--clr-accent);
  margin-bottom: 1rem;
  animation: floatStar 3s ease-in-out infinite;
}
.random-story-section h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  color: var(--clr-white);
  margin-bottom: 0.6em;
}
.random-story-section p {
  color: var(--clr-muted);
  margin-bottom: 2rem;
}
.btn-random {
  font-size: 1rem;
  padding: 0.85em 2.4em;
  gap: 0.6em;
  box-shadow: 0 0 28px rgba(201,169,110,0.25);
  position: relative;
  overflow: hidden;
}
.btn-random::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.15) 50%, transparent 70%);
  transform: translateX(-100%);
  transition: transform 0.55s ease;
}
.btn-random:hover::after { transform: translateX(100%); }
.dice {
  display: inline-block;
  transition: transform 0.4s ease;
}
.btn-random:hover .dice { transform: rotate(180deg) scale(1.3); }

@keyframes floatStar {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50%       { transform: translateY(-8px) rotate(20deg); }
}

/* =====================================================
   STORY MODAL
   ===================================================== */
.story-modal {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}
.story-modal[hidden] { display: none; }

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(6,6,8,0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  cursor: pointer;
}

.modal-card {
  position: relative;
  z-index: 1;
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  box-shadow: 0 24px 80px rgba(0,0,0,0.8);
  width: 100%;
  max-width: 720px;
  max-height: 90dvh;
  overflow-y: auto;
  overscroll-behavior: contain;
  animation: modalIn 0.35s cubic-bezier(0.34,1.56,0.64,1) both;
  scrollbar-width: thin;
  scrollbar-color: var(--clr-border) transparent;
}
.modal-card::-webkit-scrollbar { width: 5px; }
.modal-card::-webkit-scrollbar-track { background: transparent; }
.modal-card::-webkit-scrollbar-thumb { background: var(--clr-border); border-radius: 99px; }

@keyframes modalIn {
  from { opacity: 0; transform: scale(0.88) translateY(24px); }
  to   { opacity: 1; transform: scale(1)    translateY(0); }
}

.modal-close {
  position: absolute;
  top: 1rem; right: 1rem;
  background: var(--clr-surface-2);
  border: 1px solid var(--clr-border);
  color: var(--clr-muted);
  width: 36px; height: 36px;
  border-radius: 50%;
  font-size: 0.95rem;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: background var(--transition), color var(--transition);
  z-index: 2;
}
.modal-close:hover { background: var(--clr-border); color: var(--clr-white); }

.modal-header {
  padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.5rem) 0;
}
.modal-header h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.3rem, 3vw, 2rem);
  color: var(--clr-white);
  line-height: 1.3;
  margin-bottom: 0.5em;
}
.modal-meta {
  display: flex;
  align-items: center;
  gap: 0.5em;
  font-size: 0.8rem;
  color: var(--clr-muted);
  margin-top: 0.4em;
}

.modal-img-wrap {
  margin-top: 1.5rem;
  aspect-ratio: 16/9;
  overflow: hidden;
}
.modal-img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.modal-img-wrap:hover img { transform: scale(1.03); }

.modal-body {
  padding: clamp(1.25rem, 4vw, 2rem) clamp(1.5rem, 4vw, 2.5rem);
  color: var(--clr-muted);
  line-height: 1.85;
  font-size: 0.975rem;
}
.modal-body p { margin-bottom: 1.1em; }
.modal-body p:last-child { margin-bottom: 0; }
.modal-body strong { color: var(--clr-text); }
.modal-body em { font-style: italic; color: rgba(224,221,216,0.75); }

.modal-footer {
  padding: 0 clamp(1.5rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.5rem);
  display: flex;
  justify-content: center;
}

/* =====================================================
   ABOUT
   ===================================================== */
.about {
  padding-block: clamp(4rem, 10vw, 8rem);
}
.about-inner {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: clamp(2rem, 6vw, 5rem);
  align-items: center;
}

@media (max-width: 768px) {
  .about-inner { grid-template-columns: 1fr; }
}

.about-img-wrap {
  aspect-ratio: 1/1;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-img);
  position: relative;
}
.about-img-wrap::before {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: inherit;
  background: linear-gradient(135deg, var(--clr-accent), transparent 60%);
  z-index: -1;
  opacity: 0.5;
}
.about-img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: top center;
  transition: transform var(--transition);
}
.about-img-wrap:hover img { transform: scale(1.03); }

.about-text .tag { margin-bottom: 0.8em; }
.about-text h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  color: var(--clr-white);
  margin-bottom: 1rem;
}
.about-text p {
  color: var(--clr-muted);
  margin-bottom: 0.85em;
}
.about-text strong { color: var(--clr-text); }

